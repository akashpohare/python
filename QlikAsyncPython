import asyncio
import websockets
import json
import ssl

# Paths to exported certificates (from QMC)
cert_dir = "/path/to/certs/"
root_pem = cert_dir + "root.pem"
client_pem = cert_dir + "client.pem"
client_key_pem = cert_dir + "client_key.pem"

# Server details
server = "your-qlik-server.domain.com"
url = f"wss://{server}:4747/app/"  # Or append /<app_guid> for a specific app

# SSL context with client certificates
ssl_context = ssl.create_default_context(ssl.Purpose.SERVER_AUTH)
ssl_context.load_cert_chain(certfile=client_pem, keyfile=client_key_pem)
ssl_context.load_verify_locations(cafile=root_pem)
ssl_context.check_hostname = False  # Disable if hostname doesn't match (less secure, for testing)

# Optional: Add X-Qlik-User header only if required by your setup
additional_headers = {
    "X-Qlik-User": "UserDirectory=INTERNAL; UserId=sa_repository"
}

async def connect_and_interact():
    async with websockets.connect(
        url,
        ssl=ssl_context,
        additional_headers=additional_headers,  # Fixed: use additional_headers
        max_size=None
    ) as ws:
        print("Connected to Qlik Engine!")

        # Example: Get list of apps
        request = {
            "handle": -1,
            "method": "GetDocList",
            "params": {},
            "id": 1
        }
        await ws.send(json.dumps(request))
        print("Sent GetDocList request")

        # Receive responses (multiple messages may arrive)
        async for message in ws:
            data = json.loads(message)
            print("Received:", json.dumps(data, indent=2))

asyncio.run(connect_and_interact())
