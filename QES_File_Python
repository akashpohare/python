import websocket
import json
import ssl

# Qlik Sense Enterprise WebSocket URL
QLIK_SENSE_SERVER_URL = "wss://your-qlik-server:4747/app/"

# Paths to Qlik Sense client certificates
CERTIFICATE_PATH = "path/to/client.pem"
PRIVATE_KEY_PATH = "path/to/client_key.pem"
ROOT_CERT_PATH = "path/to/root.pem"

def on_message(ws, message):
    """Handles messages received from Qlik Sense Engine."""
    response = json.loads(message)

    if "result" in response:
        if "qDocList" in response["result"]:  # Extract App List
            app_list = response["result"]["qDocList"]
            print("\nAvailable Qlik Sense Apps:")
            for app in app_list:
                print(f"App ID: {app['qDocId']} | App Name: {app['qTitle']}")
            
            # Extract script from each app one by one
            for app in app_list:
                extract_script_from_app(app["qDocId"])
        
        elif "qScript" in response["result"]:  # Extract Load Script
            print(f"\nExtracted Script:\n{response['result']['qScript']}\n")

def on_error(ws, error):
    """Handles errors in the WebSocket connection."""
    print("Error:", error)

def on_close(ws, close_status_code, close_msg):
    """Handles WebSocket connection closing."""
    print("### Connection closed ###")

def on_open_get_apps(ws):
    """Handles the opening of the WebSocket connection to get the list of apps."""
    print("### Connection opened to retrieve app list ###")

    # Request the list of available applications
    request = {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "GetDocList",
        "handle": -1,
        "params": []
    }

    ws.send(json.dumps(request))

def on_open_get_script(ws, app_id):
    """Handles opening a connection for extracting script from a specific app."""
    print(f"### Connection opened to extract script from App ID: {app_id} ###")

    # Request to open the app
    request_open_app = {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "OpenDoc",
        "handle": -1,
        "params": [app_id]
    }
    
    ws.send(json.dumps(request_open_app))

    # Request to get the script from the app
    request_get_script = {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "GetScript",
        "handle": 1,
        "params": []
    }

    ws.send(json.dumps(request_get_script))

def connect_to_qlik_sense(url, cert_path, key_path, root_cert_path, on_open_callback, app_id=None):
    """Establishes a secure WebSocket connection with Qlik Sense Engine API."""
    websocket.enableTrace(False)  # Disable debugging logs

    ws = websocket.WebSocketApp(
        url,
        on_message=on_message,
        on_error=on_error,
        on_close=on_close
    )

    if app_id:
        ws.on_open = lambda ws: on_open_callback(ws, app_id)
    else:
        ws.on_open = on_open_callback

    # Start secure WebSocket connection
    ws.run_forever(sslopt={
        "certfile": cert_path,
        "keyfile": key_path,
        "ca_certs": root_cert_path,
        "cert_reqs": ssl.CERT_REQUIRED
    })

def extract_script_from_app(app_id):
    """Connects to Qlik Sense and extracts the script from a specific app."""
    connect_to_qlik_sense(
        QLIK_SENSE_SERVER_URL,
        CERTIFICATE_PATH,
        PRIVATE_KEY_PATH,
        ROOT_CERT_PATH,
        on_open_get_script,
        app_id
    )

